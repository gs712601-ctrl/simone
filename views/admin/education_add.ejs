<%- include('header.ejs'); %>

      <div class="main">
        <header class="topbar">
          <h2>Add Education Record</h2>
          <div class="user">Welcome, Admin</div>
        </header>

        <section class="content">
          <div class="panel">
            <h3 Education Form</h3>
           <form class="form" action="/admin/education_save" method="post">
              <div class="row">
                <div class="field">
                  <label for="name">Education Year</label>
                  <input id="name" type="date" name="e_year" placeholder="fa fa-icons" />
                </div>
                <div class="field">
                  <label for="text">Education Title</label>
                  <input id="text" type="text" name="e_title"  placeholder="title...." />
                </div>
              </div>


              <div class="field">
                <label for="notes" Education Description</label>
                <textarea id="notes" name="e_desc" placeholder="Short note..."></textarea>
              </div>

              <div class="actions">
                <button class="btn" type="submit">Save</button>
                <button class="btn btn-ghost" type="reset">Clear</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
 <%- include('footer.ejs'); %>